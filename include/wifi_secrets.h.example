// =====================================================================
// wifi_secrets.h.example
//
// Copy to include/wifi_secrets.h and fill in for bench work. The real file
// is gitignored. Anything set here is only used on the FIRST boot - after
// that the values live in NVS and are edited from the SETTINGS page, which
// always wins because cfg::begin() applies the saved blob afterwards.
//
// The default OpenHaldex-C6 access point is open (empty password), so the
// example below is usually all you need.
// =====================================================================
#pragma once

#define OHX_WIFI_SSID "OpenHaldex-C6"
#define OHX_WIFI_PASS ""
#define OHX_HOST "192.168.1.1"
